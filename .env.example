# ── Base de données ──────────────────────────────────────────────────────────
# `docker compose up -d` démarre un PostgreSQL correspondant à cette URL.
DATABASE_URL="postgresql://lifequest:lifequest@localhost:5433/lifequest?schema=public"

# ── Auth.js ──────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET="remplacez-moi"
# Laisse Auth.js déduire l'URL depuis la requête (utile si le port 3000 est pris).
# En production, définir AUTH_URL avec l'URL publique du site.
AUTH_TRUST_HOST=true

# ── Développement ────────────────────────────────────────────────────────────
# Origines autorisées à charger les ressources du serveur de dev, en plus de
# localhost. Nécessaire pour ouvrir l'application depuis un autre appareil du
# réseau (l'URL « Network » affichée par `next dev`) : sans elle, Next bloque
# les chunks, React n'hydrate pas et les formulaires cessent de fonctionner.
DEV_ORIGINS=""

# ── Assistant IA (facultatif) ────────────────────────────────────────────────
# Sans clé, l'assistant bascule automatiquement sur son moteur déterministe :
# toutes les fonctionnalités restent disponibles.
#
# Deux fournisseurs sont câblés ; Mistral est prioritaire s'il est renseigné.
# Clé sur https://console.mistral.ai → API Keys.
MISTRAL_API_KEY=""
# Facultatif — par défaut `mistral-large-latest`.
MISTRAL_MODEL=""

ANTHROPIC_API_KEY=""

# ── Stockage des fichiers (facultatif) ───────────────────────────────────────
# Sans configuration, les pièces jointes n'acceptent qu'une URL externe.
# `docker compose up -d` démarre un MinIO correspondant à ces valeurs et crée
# le bucket automatiquement.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="lifequest"
S3_ACCESS_KEY_ID="lifequest"
S3_SECRET_ACCESS_KEY="lifequest"
# `auto` convient à MinIO et R2 ; AWS attend une vraie région (eu-west-3…).
S3_REGION="auto"
# MinIO adresse les buckets en sous-chemin. Passer à `false` pour AWS S3.
S3_FORCE_PATH_STYLE="true"
