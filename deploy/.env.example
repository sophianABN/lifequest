# ─────────────────────────────────────────────────────────────────────────────
# LifeQuest — variables de production.
# Se recopie en /srv/apps/lifequest/.env sur le VPS, en mode 600.
# Ne jamais versionner le fichier rempli.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identité du déploiement ──────────────────────────────────────────────────
# Le commit complet doit être identique dans ces deux valeurs et dans
# /srv/apps/lifequest/DEPLOYED_REVISION. `deploy.sh` s'en charge.
LIFEQUEST_IMAGE_REGISTRY=ghcr.io/sophianabn
LIFEQUEST_IMAGE_TAG=sha-0000000000000000000000000000000000000000
LIFEQUEST_REVISION=0000000000000000000000000000000000000000

# ── Domaine ──────────────────────────────────────────────────────────────────
APP_DOMAIN=lifequest.absoley.fr

# ── Base de données ──────────────────────────────────────────────────────────
# `postgres` est le nom du service Compose : c'est le nom d'hôte à utiliser.
# Générer le mot de passe avec `openssl rand -hex 24` — que des caractères
# sûrs dans une URL, contrairement à `rand -base64`.
POSTGRES_USER=lifequest
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=lifequest
DATABASE_URL=postgresql://lifequest:a-remplacer@postgres:5432/lifequest?schema=public

# ── Auth.js ──────────────────────────────────────────────────────────────────
# openssl rand -base64 32
# Les valeurs ci-dessous ne sont que des jalons : la CI valide le manifeste
# avec ce fichier, les variables obligatoires doivent donc être non vides.
AUTH_SECRET=a-remplacer
# AUTH_URL est dérivé de APP_DOMAIN par le compose, rien à renseigner ici.

# ── Assistant IA (facultatif) ────────────────────────────────────────────────
# Sans clé, l'assistant bascule sur son moteur déterministe : rien ne casse.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
ANTHROPIC_API_KEY=

# ── Stockage des fichiers (facultatif) ───────────────────────────────────────
# Cloudflare R2 : endpoint https://<account_id>.r2.cloudflarestorage.com
# Garder le bucket privé — l'application sert les fichiers elle-même après
# vérification du propriétaire.
S3_ENDPOINT=
S3_BUCKET=lifequest
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# ── Contact (recommandé) ─────────────────────────────────────────────────────
# Affichée sur /confidentialite : demandes d'accès et suppression d'un compte
# devenu inaccessible. L'App Store et le Play Store attendent un contact.
CONTACT_EMAIL=
