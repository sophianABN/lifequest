// ─────────────────────────────────────────────────────────────────────────────
// LifeQuest — modèle de données
//
// Principe : l'utilisateur possède des OBJECTIFS de vie, décomposés en ÉTAPES
// (elles-mêmes imbricables). Tout le reste (journal, badges, calendrier,
// notifications) gravite autour de ces deux entités.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Énumérations ────────────────────────────────────────────────────────────

/// Colonnes du Kanban. L'ordre de déclaration = l'ordre d'affichage.
enum GoalStatus {
  TODO // À faire
  IN_PROGRESS // En cours
  WAITING // En attente (dépend d'un tiers, d'une date…)
  BLOCKED // Bloqué (manque argent / âge / prérequis)
  DONE // Terminé
  ARCHIVED // Abandonné ou repoussé hors périmètre
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Résultat du moteur d'intelligence : « puis-je m'y mettre aujourd'hui ? »
enum Readiness {
  READY // Réalisable maintenant
  SOON // Réalisable bientôt (< 6 mois) si on continue
  LATER // Nécessite du temps ou de l'épargne
  LOCKED // Verrou dur (âge, prérequis légal, autre objectif non terminé)
}

enum AttachmentType {
  DOCUMENT
  PHOTO
  LINK
}

enum CalendarEventKind {
  TASK // Étape planifiée
  MILESTONE // Jalon d'un objectif
  REMINDER // Rappel
  EVENT // Événement libre
}

enum NotificationType {
  REMINDER
  STEP_OVERDUE
  GOAL_DEADLINE
  MOTIVATION
  BADGE_UNLOCKED
  BIRTHDAY
  STREAK
}

enum Mood {
  AWFUL
  BAD
  NEUTRAL
  GOOD
  GREAT
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─── Utilisateur & profil ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  image         String?

  // Profil de vie — alimente le moteur d'intelligence
  birthDate       DateTime?
  /// Échéance globale de la quête (ex. « avant mes 25 ans »)
  deadlineDate    DateTime?
  questTitle      String    @default("25 choses à faire avant mes 25 ans")
  bio             String?
  city            String?
  country         String?
  locale          String    @default("fr")
  timezone        String    @default("Europe/Paris")
  schoolLevel     String?
  /// Heures libres par semaine, sert à estimer la faisabilité temporelle
  freeHoursWeekly Int       @default(10)
  /// Capacité d'épargne mensuelle en euros
  monthlySavings  Int       @default(0)
  /// Trésorerie disponible non affectée à un objectif
  availableBudget Int       @default(0)

  // Gamification
  xp             Int       @default(0)
  level          Int       @default(1)
  streakCurrent  Int       @default(0)
  streakLongest  Int       @default(0)
  lastActiveDate DateTime?

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
  categories    Category[]
  people        Person[]
  skills        Skill[]
  languages     Language[]
  constraints   Constraint[]
  journal       JournalEntry[]
  badges        UserBadge[]
  xpEvents      XpEvent[]
  notifications Notification[]
  events        CalendarEvent[]
  comments      Comment[]
  conversations AiConversation[]
}

/// Compétence maîtrisée ou en cours d'acquisition (débloque des objectifs).
model Skill {
  id     String     @id @default(cuid())
  userId String
  name   String
  level  SkillLevel @default(BEGINNER)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Language {
  id     String  @id @default(cuid())
  userId String
  name   String
  /// Niveau CECRL : A1 → C2
  level  String  @default("A1")
  target String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

/// Contrainte de vie déclarée (« pas d'avion avant le bac », « budget bloqué »…).
model Constraint {
  id     String    @id @default(cuid())
  userId String
  label  String
  until  DateTime?
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Auth.js ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Objectifs ───────────────────────────────────────────────────────────────

model Category {
  id     String  @id @default(cuid())
  userId String
  name   String
  slug   String
  /// Couleur de la charte : rose | lavender | turquoise | gold | mint | peach…
  color  String  @default("rose")
  emoji  String?
  order  Int     @default(0)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals  Goal[]

  @@unique([userId, slug])
}

model Goal {
  id          String  @id @default(cuid())
  userId      String
  slug        String
  title       String
  description String?
  /// Pourquoi cet objectif compte — affiché dans les moments de démotivation
  motivation  String?
  notes       String?
  coverImage  String?
  color       String  @default("rose")
  emoji       String?

  categoryId String?

  status     GoalStatus @default(TODO)
  priority   Priority   @default(MEDIUM)
  /// 1 (facile) → 5 (extrême)
  difficulty Int        @default(3)

  // Temps
  startDate      DateTime?
  targetDate     DateTime?
  completedAt    DateTime?
  estimatedHours Int?

  // Argent (en euros, entiers : pas de centimes sur des objectifs de vie)
  estimatedCost Int?
  savedAmount   Int  @default(0)

  // Contexte
  country String?
  city    String?
  /// Âge minimum requis — verrou dur du moteur d'intelligence
  minAge  Int?

  /// Progression 0-100, dénormalisée depuis les étapes (voir server/actions/progress)
  progress Int @default(0)

  /// Cache du moteur d'intelligence
  aiScore     Int       @default(0)
  aiReadiness Readiness @default(READY)
  /// Explications lisibles des blocages détectés
  aiBlockers  String[]  @default([])

  /// L'objectif final, mis en scène différemment dans toute l'UI
  isFinal   Boolean @default(false)
  isFavorit Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  steps           Step[]
  checklist       ChecklistItem[]
  attachments     Attachment[]
  comments        Comment[]
  people          GoalPerson[]
  events          CalendarEvent[]
  journal         JournalEntry[]
  xpEvents        XpEvent[]
  aiConversations AiConversation[]

  /// Objectifs prérequis (ex. « avoir le bac » avant « partir un an à l'étranger »)
  dependsOn     GoalDependency[] @relation("dependent")
  requiredFor   GoalDependency[] @relation("prerequisite")
  notifications Notification[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([userId, targetDate])
}

/// Arête d'un graphe orienté acyclique entre objectifs.
model GoalDependency {
  id             String @id @default(cuid())
  goalId         String
  prerequisiteId String

  goal         Goal @relation("dependent", fields: [goalId], references: [id], onDelete: Cascade)
  prerequisite Goal @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([goalId, prerequisiteId])
}

/// Étape planifiable. `parentId` permet des sous-étapes à profondeur illimitée.
model Step {
  id          String  @id @default(cuid())
  goalId      String
  parentId    String?
  title       String
  description String?

  done        Boolean   @default(false)
  completedAt DateTime?

  dueDate          DateTime?
  reminderAt       DateTime?
  estimatedMinutes Int?
  priority         Priority  @default(MEDIUM)
  order            Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal     Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  parent   Step?           @relation("substeps", fields: [parentId], references: [id], onDelete: Cascade)
  children Step[]          @relation("substeps")
  events   CalendarEvent[]

  @@index([goalId, order])
}

/// Micro-tâche à cocher, sans date ni hiérarchie (≠ Step).
model ChecklistItem {
  id     String  @id @default(cuid())
  goalId String
  label  String
  done   Boolean @default(false)
  order  Int     @default(0)
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Person {
  id     String       @id @default(cuid())
  userId String
  name   String
  role   String?
  avatar String?
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals  GoalPerson[]
}

model GoalPerson {
  goalId   String
  personId String
  goal     Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([goalId, personId])
}

model Attachment {
  id        String         @id @default(cuid())
  goalId    String
  name      String
  url       String
  type      AttachmentType @default(DOCUMENT)
  mimeType  String?
  size      Int?
  createdAt DateTime       @default(now())
  goal      Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Calendrier ──────────────────────────────────────────────────────────────

model CalendarEvent {
  id     String            @id @default(cuid())
  userId String
  goalId String?
  stepId String?
  title  String
  notes  String?
  start  DateTime
  end    DateTime?
  allDay Boolean           @default(false)
  kind   CalendarEventKind @default(EVENT)
  color  String?
  done   Boolean           @default(false)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  step Step? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([userId, start])
}

// ─── Journal ─────────────────────────────────────────────────────────────────

model JournalEntry {
  id           String   @id @default(cuid())
  userId       String
  goalId       String?
  /// Jour concerné, normalisé à minuit (une entrée par jour)
  date         DateTime
  whatIDid     String?
  whatILearned String?
  notes        String?
  mood         Mood     @default(NEUTRAL)
  gratitude    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  photos JournalPhoto[]

  @@unique([userId, date])
  @@index([userId, date])
}

model JournalPhoto {
  id      String       @id @default(cuid())
  entryId String
  url     String
  caption String?
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

// ─── Gamification ────────────────────────────────────────────────────────────

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String
  /// bronze | silver | gold | legendary — pilote le rendu visuel
  tier        String @default("bronze")
  xpReward    Int    @default(50)
  /// Règle de déblocage évaluée par lib/gamification/badges.ts
  rule        Json

  users UserBadge[]
}

model UserBadge {
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  seen       Boolean  @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

/// Journal d'XP : permet de reconstruire les courbes de progression.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  goalId    String?
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  goalId    String?
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Citations motivantes — une par jour, tirée de façon déterministe.
model Quote {
  id     String  @id @default(cuid())
  text   String
  author String?
}

// ─── Assistant IA ────────────────────────────────────────────────────────────

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("Nouvelle conversation")
  /// Objectif sur lequel la conversation était centrée au démarrage.
  goalId    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  messages  AiMessage[]

  /// La liste latérale trie les conversations d'un utilisateur par fraîcheur.
  @@index([userId, updatedAt])
}

model AiMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  /// Trace des outils appelés (création d'étapes, planning…)
  toolCalls      Json?
  createdAt      DateTime    @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
